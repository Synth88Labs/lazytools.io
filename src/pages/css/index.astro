---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrivacyStrip from '../../components/PrivacyStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import AdsterraSlot from '../../components/ads/AdsterraSlot.astro';
import { AD_UNITS } from '../../lib/ads';
import { CSS_TOOLS } from '../../data/css/index';
import { breadcrumbSchema, collectionPageSchema, faqSchema } from '../../lib/schema';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'CSS & Design', url: '/css/' },
];

const faqs = [
  { q: 'Do these CSS generators write real, valid CSS?', a: 'Yes. Each tool outputs standard CSS you can paste straight into a stylesheet, with a live preview so you see the result before you copy. No frameworks or build steps are needed.' },
  { q: 'Is anything I design uploaded?', a: 'No. Every generator runs entirely in your browser; the CSS is built locally and never sent to a server. They work offline.' },
  { q: 'Do I need to know CSS to use them?', a: 'No. The visual controls let you design by eye, and the live preview teaches you what each property does. The copyable code is there when you want it.' },
];

const schema = [
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: 'CSS & Design Generators',
    url: '/css/',
    description: 'Visual CSS generators with live preview: box-shadow, border-radius, text-shadow, filters, flexbox, grid, cubic-bezier easing, glassmorphism, clip-path and transforms.',
    items: CSS_TOOLS.map((t) => ({ name: t.name, url: `/css/${t.slug}/` })),
  }),
  faqSchema(faqs),
];
---

<Base
  title="CSS & Design Generators | LazyTools"
  description={`${CSS_TOOLS.length} free visual CSS generators with live preview and copyable code: box-shadow, border-radius, flexbox, grid, filters, glassmorphism, clip-path and more. All in your browser.`}
  schema={schema}
>
  <div class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} />

    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">CSS &amp; Design Generators</h1>
    <p class="mt-3 max-w-3xl text-lg leading-relaxed text-slate-700">
      Design CSS by eye, box-shadow, rounded corners, filters, flexbox, grid, easing curves, glassmorphism
      and more, with a <strong class="font-semibold text-slate-900">live preview</strong> and copyable code.
      Everything runs in your browser.
    </p>

    <div class="mt-5">
      <PrivacyStrip />
    </div>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {CSS_TOOLS.map((t) => (
        <li>
          <a href={`/css/${t.slug}/`} class="flex h-full flex-col rounded-xl border border-slate-200 p-4 transition hover:border-brand-400 hover:shadow-sm">
            <span class="text-2xl" aria-hidden="true">{t.icon}</span>
            <span class="mt-2 font-semibold text-slate-900">{t.name}</span>
            <span class="mt-1 text-sm text-slate-600">{t.lead.split(/[.—]/)[0]}</span>
          </a>
        </li>
      ))}
    </ul>

    <AdsterraSlot desktop={AD_UNITS.leaderboard} mobile={AD_UNITS.mobile} />

    <section class="prose-lazy mt-8">
      <h2>Design in the browser, copy the code</h2>
      <p>These generators turn the fiddly parts of CSS, shadow offsets, easing curves, grid tracks, clip-path points, into visual controls with an instant preview. Adjust by eye, and the exact CSS updates alongside, ready to copy into your stylesheet.</p>
      <p>Because they run on your device, there is no lag and nothing you build is uploaded. They are as handy for learning what a property does as for shipping production CSS.</p>
    </section>

    <FaqSection faqs={faqs} />
  </div>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { seoTitle } from '../../lib/seo';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrivacyStrip from '../../components/PrivacyStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import RatingWidget from '../../components/RatingWidget.tsx';
import FancyTextTool from '../../components/fonts/FancyTextTool.tsx';
import PxRemCalc from '../../components/fonts/PxRemCalc.tsx';
import TypeScaleTool from '../../components/fonts/TypeScaleTool.tsx';
import LineHeightCalc from '../../components/fonts/LineHeightCalc.tsx';
import ZalgoTool from '../../components/fonts/ZalgoTool.tsx';
import BlankNameTool from '../../components/fonts/BlankNameTool.tsx';
import SymbolPicker from '../../components/fonts/SymbolPicker.tsx';
import DiscordColorTool from '../../components/fonts/DiscordColorTool.tsx';
import ClampTool from '../../components/fonts/ClampTool.tsx';
import TextRepeater from '../../components/fonts/TextRepeater.tsx';
import MirrorTool from '../../components/fonts/MirrorTool.tsx';
import LennyPicker from '../../components/fonts/LennyPicker.tsx';
import GradientTextTool from '../../components/fonts/GradientTextTool.tsx';
import MeasureTool from '../../components/fonts/MeasureTool.tsx';
import AsciiArtTool from '../../components/fonts/AsciiArtTool.tsx';
import FontInspectorTool from '../../components/fonts/FontInspectorTool.tsx';
import { FONT_TOOLS, type FontToolDef } from '../../data/fonts/index';
import { breadcrumbSchema, webApplicationSchema, faqSchema } from '../../lib/schema';
import { ratingFor } from '../../lib/ratings';

export function getStaticPaths() {
  return FONT_TOOLS.map((t) => ({ params: { slug: t.slug }, props: { slug: t.slug } }));
}

const { slug } = Astro.props;
const tool: FontToolDef = FONT_TOOLS.find((t) => t.slug === slug)!;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Fonts & Typography', url: '/fonts/' },
  { name: tool.name, url: `/fonts/${tool.slug}/` },
];

const related = FONT_TOOLS.filter((t) => t.slug !== tool.slug).slice(0, 8);
const allBlogPosts = await getCollection('blog');
const blogPosts = allBlogPosts.filter((p) => p.data.tools.includes(`/fonts/${tool.slug}/`));

const schema = [
  breadcrumbSchema(crumbs),
  webApplicationSchema({
    name: tool.name,
    url: `/fonts/${tool.slug}/`,
    description: tool.description,
    rating: ratingFor(`fonts/${tool.slug}`),
  }),
  faqSchema(tool.faqs),
];
---

<Base title={seoTitle(tool.name)} description={tool.description} schema={schema}>
  <article class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} />

    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      {tool.icon} {tool.name}
    </h1>

    <p class="mt-3 text-lg leading-relaxed text-slate-700">
      <strong class="font-semibold text-slate-900">{tool.lead}</strong>
    </p>

    <div class="mt-6">
      {tool.widget === 'fancy' && <FancyTextTool client:load styles={tool.styles} placeholder={tool.placeholder} />}
      {tool.widget === 'pxrem' && <PxRemCalc client:load />}
      {tool.widget === 'typescale' && <TypeScaleTool client:load />}
      {tool.widget === 'lineheight' && <LineHeightCalc client:load />}
      {tool.widget === 'zalgo' && <ZalgoTool client:load />}
      {tool.widget === 'blank' && <BlankNameTool client:load />}
      {tool.widget === 'symbols' && <SymbolPicker client:load />}
      {tool.widget === 'discord' && <DiscordColorTool client:load />}
      {tool.widget === 'clamp' && <ClampTool client:load />}
      {tool.widget === 'repeater' && <TextRepeater client:load />}
      {tool.widget === 'mirror' && <MirrorTool client:load />}
      {tool.widget === 'lenny' && <LennyPicker client:load />}
      {tool.widget === 'gradient' && <GradientTextTool client:load />}
      {tool.widget === 'measure' && <MeasureTool client:load />}
      {tool.widget === 'ascii' && <AsciiArtTool client:load />}
      {tool.widget === 'fontinspect' && <FontInspectorTool client:load />}
    </div>

    <div class="mt-4">
      <PrivacyStrip />
    </div>

    <div class="mt-3">
      <RatingWidget
        client:idle
        toolSlug={`fonts/${tool.slug}`}
        avg={ratingFor(`fonts/${tool.slug}`)?.avg}
        count={ratingFor(`fonts/${tool.slug}`)?.count}
      />
    </div>

    <section class="prose-lazy mt-6">
      <h2>How the {tool.name.toLowerCase()} works</h2>
      <p>{tool.how}</p>
      {tool.note && <p>{tool.note}</p>}
    </section>

    <FaqSection faqs={tool.faqs} />

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-slate-900">More fonts & typography tools</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {related.map((r) => (
          <li>
            <a href={`/fonts/${r.slug}/`} class="block rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:border-brand-400 hover:text-brand-700">
              {r.icon} {r.name}
            </a>
          </li>
        ))}
        <li>
          <a href="/fonts/" class="block rounded-lg border border-brand-200 bg-brand-50 px-4 py-2.5 text-sm font-semibold text-brand-800 transition hover:border-brand-400">
            All fonts & typography tools →
          </a>
        </li>
      </ul>
    </section>

    {
      blogPosts.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold text-slate-900">From the blog</h2>
          <ul class="mt-4 space-y-3">
            {blogPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="block rounded-xl border border-slate-200 p-4 transition hover:border-brand-400 hover:shadow-sm">
                  <p class="font-semibold text-slate-900">{post.data.title}</p>
                  <p class="mt-1 text-sm text-slate-600">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

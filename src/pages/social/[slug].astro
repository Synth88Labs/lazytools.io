---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdsterraSlot from '../../components/ads/AdsterraSlot.astro';
import { AD_UNITS } from '../../lib/ads';
import { seoTitle } from '../../lib/seo';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrivacyStrip from '../../components/PrivacyStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import RatingWidget from '../../components/RatingWidget.tsx';
import EngagementRateTool from '../../components/social/EngagementRateTool.tsx';
import CpmTool from '../../components/social/CpmTool.tsx';
import CpcTool from '../../components/social/CpcTool.tsx';
import CtrTool from '../../components/social/CtrTool.tsx';
import RoasTool from '../../components/social/RoasTool.tsx';
import CpaTool from '../../components/social/CpaTool.tsx';
import YoutubeMoneyTool from '../../components/social/YoutubeMoneyTool.tsx';
import TiktokMoneyTool from '../../components/social/TiktokMoneyTool.tsx';
import FollowerGrowthTool from '../../components/social/FollowerGrowthTool.tsx';
import InfluencerRateTool from '../../components/social/InfluencerRateTool.tsx';
import { SOCIAL_TOOLS, type SocialToolDef } from '../../data/social/index';
import { breadcrumbSchema, webApplicationSchema, faqSchema } from '../../lib/schema';
import { ratingFor } from '../../lib/ratings';

export function getStaticPaths() {
  return SOCIAL_TOOLS.map((t) => ({ params: { slug: t.slug }, props: { slug: t.slug } }));
}

const { slug } = Astro.props;
const tool: SocialToolDef = SOCIAL_TOOLS.find((t) => t.slug === slug)!;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Social & Creator', url: '/social/' },
  { name: tool.name, url: `/social/${tool.slug}/` },
];

const related = SOCIAL_TOOLS.filter((t) => t.slug !== tool.slug).slice(0, 6);
const allBlogPosts = await getCollection('blog');
const blogPosts = allBlogPosts.filter((p) => p.data.tools.includes(`/social/${tool.slug}/`));

const schema = [
  breadcrumbSchema(crumbs),
  webApplicationSchema({ name: tool.name, url: `/social/${tool.slug}/`, description: tool.description, rating: ratingFor(`social/${tool.slug}`) }),
  faqSchema(tool.faqs),
];
---

<Base title={seoTitle(tool.name)} description={tool.description} schema={schema}>
  <article class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} />

    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      {tool.icon} {tool.name}
    </h1>

    <p class="mt-3 text-lg leading-relaxed text-slate-700">
      <strong class="font-semibold text-slate-900">{tool.lead}</strong>
    </p>

    <div class="mt-6">
      {tool.widget === 'engagement' && <EngagementRateTool client:load />}
      {tool.widget === 'cpm' && <CpmTool client:load />}
      {tool.widget === 'cpc' && <CpcTool client:load />}
      {tool.widget === 'ctr' && <CtrTool client:load />}
      {tool.widget === 'roas' && <RoasTool client:load />}
      {tool.widget === 'cpa' && <CpaTool client:load />}
      {tool.widget === 'youtube' && <YoutubeMoneyTool client:load />}
      {tool.widget === 'tiktok' && <TiktokMoneyTool client:load />}
      {tool.widget === 'follower-growth' && <FollowerGrowthTool client:load />}
      {tool.widget === 'influencer-rate' && <InfluencerRateTool client:load />}
    </div>

    <div class="mt-4">
      <PrivacyStrip />
    </div>

    <div class="mt-3">
      <RatingWidget client:idle toolSlug={`social/${tool.slug}`} avg={ratingFor(`social/${tool.slug}`)?.avg} count={ratingFor(`social/${tool.slug}`)?.count} />
    </div>

    <AdsterraSlot desktop={AD_UNITS.leaderboard} mobile={AD_UNITS.mobile} />

    <section class="prose-lazy mt-6">
      <h2>How the {tool.name.toLowerCase()} works</h2>
      <p>{tool.how}</p>
      {tool.note && <p>{tool.note}</p>}
    </section>

    <FaqSection faqs={tool.faqs} />

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-slate-900">More social &amp; creator tools</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {related.map((r) => (
          <li>
            <a href={`/social/${r.slug}/`} class="block rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:border-brand-400 hover:text-brand-700">
              {r.icon} {r.name}
            </a>
          </li>
        ))}
        <li>
          <a href="/social/" class="block rounded-lg border border-brand-200 bg-brand-50 px-4 py-2.5 text-sm font-semibold text-brand-800 transition hover:border-brand-400">
            All social &amp; creator tools →
          </a>
        </li>
      </ul>
    </section>

    {
      blogPosts.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold text-slate-900">From the blog</h2>
          <ul class="mt-4 space-y-3">
            {blogPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="block rounded-xl border border-slate-200 p-4 transition hover:border-brand-400 hover:shadow-sm">
                  <p class="font-semibold text-slate-900">{post.data.title}</p>
                  <p class="mt-1 text-sm text-slate-600">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdsterraSlot from '../../components/ads/AdsterraSlot.astro';
import { AD_UNITS } from '../../lib/ads';
import { seoTitle } from '../../lib/seo';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrivacyStrip from '../../components/PrivacyStrip.astro';
import FaqSection from '../../components/FaqSection.astro';
import RatingWidget from '../../components/RatingWidget.tsx';
import SensitivityTool from '../../components/gaming/SensitivityTool.tsx';
import EdpiTool from '../../components/gaming/EdpiTool.tsx';
import KdaTool from '../../components/gaming/KdaTool.tsx';
import PokemonTool from '../../components/gaming/PokemonTool.tsx';
import MinecraftCircleTool from '../../components/gaming/MinecraftCircleTool.tsx';
import MinecraftStackTool from '../../components/gaming/MinecraftStackTool.tsx';
import GachaTool from '../../components/gaming/GachaTool.tsx';
import DiceProbTool from '../../components/gaming/DiceProbTool.tsx';
import FovTool from '../../components/gaming/FovTool.tsx';
import TeamsTool from '../../components/gaming/TeamsTool.tsx';
import { GAMING_TOOLS, type GamingToolDef } from '../../data/gaming/index';
import { breadcrumbSchema, webApplicationSchema, faqSchema } from '../../lib/schema';
import { ratingFor } from '../../lib/ratings';

export function getStaticPaths() {
  return GAMING_TOOLS.map((t) => ({ params: { slug: t.slug }, props: { slug: t.slug } }));
}

const { slug } = Astro.props;
const tool: GamingToolDef = GAMING_TOOLS.find((t) => t.slug === slug)!;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gaming', url: '/gaming/' },
  { name: tool.name, url: `/gaming/${tool.slug}/` },
];

const related = GAMING_TOOLS.filter((t) => t.slug !== tool.slug).slice(0, 6);
const allBlogPosts = await getCollection('blog');
const blogPosts = allBlogPosts.filter((p) => p.data.tools.includes(`/gaming/${tool.slug}/`));

const schema = [
  breadcrumbSchema(crumbs),
  webApplicationSchema({ name: tool.name, url: `/gaming/${tool.slug}/`, description: tool.description, rating: ratingFor(`gaming/${tool.slug}`) }),
  faqSchema(tool.faqs),
];
---

<Base title={seoTitle(tool.name)} description={tool.description} schema={schema}>
  <article class="mx-auto max-w-5xl px-4 py-6">
    <Breadcrumbs items={crumbs} />

    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      {tool.icon} {tool.name}
    </h1>

    <p class="mt-3 text-lg leading-relaxed text-slate-700">
      <strong class="font-semibold text-slate-900">{tool.lead}</strong>
    </p>

    <div class="mt-6">
      {tool.widget === 'sens' && <SensitivityTool client:load />}
      {tool.widget === 'edpi' && <EdpiTool client:load />}
      {tool.widget === 'kda' && <KdaTool client:load />}
      {tool.widget === 'pokemon' && <PokemonTool client:load />}
      {tool.widget === 'mc-circle' && <MinecraftCircleTool client:load />}
      {tool.widget === 'mc-stack' && <MinecraftStackTool client:load />}
      {tool.widget === 'gacha' && <GachaTool client:load />}
      {tool.widget === 'dice-prob' && <DiceProbTool client:load />}
      {tool.widget === 'fov' && <FovTool client:load />}
      {tool.widget === 'teams' && <TeamsTool client:load />}
    </div>

    <div class="mt-4">
      <PrivacyStrip />
    </div>

    <div class="mt-3">
      <RatingWidget client:idle toolSlug={`gaming/${tool.slug}`} avg={ratingFor(`gaming/${tool.slug}`)?.avg} count={ratingFor(`gaming/${tool.slug}`)?.count} />
    </div>

    <AdsterraSlot desktop={AD_UNITS.leaderboard} mobile={AD_UNITS.mobile} />

    <section class="prose-lazy mt-6">
      <h2>How the {tool.name.toLowerCase()} works</h2>
      <p>{tool.how}</p>
      {tool.note && <p>{tool.note}</p>}
    </section>

    <FaqSection faqs={tool.faqs} />

    <section class="mt-10">
      <h2 class="text-2xl font-bold text-slate-900">More gaming tools</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {related.map((r) => (
          <li>
            <a href={`/gaming/${r.slug}/`} class="block rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:border-brand-400 hover:text-brand-700">
              {r.icon} {r.name}
            </a>
          </li>
        ))}
        <li>
          <a href="/gaming/" class="block rounded-lg border border-brand-200 bg-brand-50 px-4 py-2.5 text-sm font-semibold text-brand-800 transition hover:border-brand-400">
            All gaming tools →
          </a>
        </li>
      </ul>
    </section>

    {
      blogPosts.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold text-slate-900">From the blog</h2>
          <ul class="mt-4 space-y-3">
            {blogPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="block rounded-xl border border-slate-200 p-4 transition hover:border-brand-400 hover:shadow-sm">
                  <p class="font-semibold text-slate-900">{post.data.title}</p>
                  <p class="mt-1 text-sm text-slate-600">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
